# ScopeCraft — Docker Compose configuration
#
# Copy to `.env` (not `.env.local` — that one is Next's, this one is Compose's):
#
#     cp .env.docker.example .env
#
# Compose reads `.env` from the project root automatically. It is gitignored.
#
# NOTHING HERE IS REQUIRED for the normal workflow. `docker compose up -d`
# starts Postgres with the defaults below, and the app runs on the host with
# `npm run dev`. You only need this file to change a port, or to run the app in
# a container with `docker compose --profile app up`.

# ---- Postgres ----
# Local-only credentials for a database published on localhost. Readable on
# purpose: there is nothing here worth protecting, and a developer who cannot
# guess the password cannot open a psql shell.
POSTGRES_USER=scopecraft
POSTGRES_PASSWORD=scopecraft
POSTGRES_DB=scopecraft

# Change this if something else on your machine already owns 5432 — a host
# Postgres, or another project's compose stack.
POSTGRES_PORT=5432

# The app on the host connects to the published port:
#   DATABASE_URL=postgres://scopecraft:scopecraft@localhost:5432/scopecraft
# Put that line in .env.local, not here. Inside the container the host is `db`,
# and compose builds that URL itself.

# ---- Only needed for `docker compose --profile app up` ----
# Running the app in a container as well as the database. Day-to-day work does
# not need any of this; see docs/local-development.md.
WEB_PORT=3000

# Generate with:  npx auth secret
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth app with callback http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# At least one provider key, or the app starts but cannot generate.
NVIDIA_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
