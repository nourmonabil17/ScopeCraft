{
  "name": "scopecraft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:psql": "docker compose exec db psql -U scopecraft -d scopecraft",
    "db:reset": "docker compose down -v && docker compose up -d",
    "test": "jest",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings=0",
    "smoke": "tsx --env-file-if-exists=.env.local scripts/smoke-test.ts",
    "capture:evidence": "bash scripts/capture-evidence.sh",
    "capture:ui": "node scripts/capture-ui-evidence.mjs"
  },
  "dependencies": {
    "next": "^16.2.12",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/jest": "29.5.12",
    "@types/node": "20.14.9",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.12",
    "identity-obj-proxy": "^3.0.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "29.1.5",
    "tsx": "^4.23.12",
    "typescript": "5.5.3"
  },
  "overrides": {
    "postcss": "8.5.24",
    "sharp": "0.35.3"
  }
}
