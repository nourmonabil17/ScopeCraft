node_modules
.next
.env.local
.env
.env.*
!.env.example
# Compose's own template. Matches `.env.*` above, so it needs its own negation
# or the file silently never commits — which is how a template stops existing.
!.env.docker.example
*.log
# ...except captured provider evidence, which is a graded artifact. Without this
# negation `*.log` silently swallows docs/evidence/raw/provider-fallback.log and
# the evidence folder commits with its central file missing.
!docs/evidence/raw/*.log
*.tsbuildinfo

# macOS and local tool droppings. These have no business in a graded repo, and a
# stray `git add -A` sweeps them in — which happened once on 2026-08-24.
.DS_Store
**/.DS_Store
.claude-flow/
**/.claude-flow/

# Local editor/tooling config, generated per machine. Not team configuration.
.claude/

# Local operating rules for AI-assisted work. Not team documentation and
# deliberately not shared: it records local paths, account names and working
# constraints that belong to this machine, not to the project.
CLAUDE.md
.neon
