# ScopeCraft — server-only environment configuration
#
# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# SECURITY: every variable below is read ONLY inside server code
# (src/lib/ai/providers.ts, src/lib/scopecraft/service.ts, the route handler).
# None of them may ever be prefixed with NEXT_PUBLIC_ — that prefix inlines the
# value into the client bundle and permanently leaks the key to every visitor.

# ---- Provider credentials (at least one is required) ----
# NVIDIA NIM — primary. Free tier, high capacity. https://build.nvidia.com
NVIDIA_API_KEY=
# Groq — first fallback. https://console.groq.com/keys
GROQ_API_KEY=
# Google Gemini — second fallback. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Failover behaviour ----
# Which provider is attempted first: nvidia | groq | gemini
PRIMARY_AI_PROVIDER=nvidia
# Per-attempt abort timeout in milliseconds. Applied to each provider
# independently. Raised from 15000 on 2026-08-28. Measured over 8 live runs at
# each setting: at 15 s, 3 of 8 timed out on NVIDIA and fell through; at 30 s,
# none did. End-to-end latency is a wash either way (median 14.2 s vs 16.1 s) —
# the gain is that fewer attempts are paid for and then discarded, not speed.
AI_TIMEOUT_MS=30000

# Ceiling for the WHOLE failover chain, in milliseconds. Each attempt gets
# whichever is smaller: AI_TIMEOUT_MS, or what is left of this. Without it the
# worst case is AI_TIMEOUT_MS x number of tiers, which grows whenever a provider
# is added and eventually outlives the hosting platform's function limit — at
# which point the caller gets the platform's untyped 504 instead of this app's
# TIMEOUT response. Must stay below `maxDuration` in the route (60 s).
AI_TOTAL_BUDGET_MS=50000

# ---- Model IDs (optional overrides) ----
# Hosted model availability changes independently of this repository. These are
# overridable so a retired model ID can be fixed by redeploying config rather
# than shipping code. Defaults live in src/lib/ai/models.ts, which both the
# server and scripts/smoke-test.ts import — so the running app and the live
# connectivity check can never disagree about which model is being called.
#
# Verify these are still live before a demo:  npm run smoke
#
# NVIDIA retired meta/llama-3.1-8b-instruct on 2026-08-27 — it answers HTTP 410
# Gone, and the whole Llama 3.x instruct family has left the NIM catalogue. The
# default below is the fastest replacement that is actually reachable on a free
# account, and slow for a full PRD: measured at 9-26 seconds. AI_TIMEOUT_MS was
# raised to 30000 so the common case fits inside the first tier instead of
# falling through to Groq after a wasted timeout.
NVIDIA_MODEL=openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.5-flash-lite

# ---- Authentication (required — /scopecraft redirects to /login without it) ----
# Signs and encrypts the session cookie. Generate with:  npx auth secret
# Rotating it invalidates every existing session, which is the only way to
# force sign-out under the JWT strategy — there is no session table to delete.
AUTH_SECRET=

# GitHub OAuth app: https://github.com/settings/developers → New OAuth App.
# The callback URL must be exactly  <your-origin>/api/auth/callback/github
# Local and production are different origins, so they need either two OAuth
# apps or two callback URLs on one app.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth client: https://console.cloud.google.com/apis/credentials →
# Create Credentials → OAuth client ID → Web application.
# The redirect URI must be exactly  <your-origin>/api/auth/callback/google
# Local and production are different origins, so they need either two OAuth
# clients or two redirect URIs on one client. If the OAuth consent screen is
# still in "Testing" publishing status, only the test users you add on that
# screen can sign in — publish it (or add testers) before sharing the app.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Set this in production only. Auth.js builds the OAuth callback URL from the
# request, and behind a proxy that can resolve to the internal host — which
# GitHub then rejects as a mismatch.
# AUTH_URL=https://scope-craft-nine.vercel.app

# ---- Database ----
# Postgres connection string. Locally this is the container from
# `npm run db:up`; the value below is the compose default and works as-is.
#
#   npm run db:up      start it
#   npm run db:check   confirm the app can reach it
#
# Production is Neon (https://console.neon.tech). Use the POOLED connection
# string — the host with `-pooler` in it — not the direct one. Serverless
# multiplies connections by instance count, and the direct endpoint has a low
# ceiling that a handful of warm functions will exhaust. Keep sslmode=require;
# Neon needs TLS, and it is easy to drop while editing the URL by hand.
#
# Neon's free tier suspends the compute after ~5 minutes idle, so the first
# query after that pays a wake-up of roughly half a second. Expected, not a bug.
#
# Server-only, like everything else in this file. A NEXT_PUBLIC_ prefix here
# would publish the database credentials to every visitor.
DATABASE_URL=postgres://scopecraft:scopecraft@localhost:5432/scopecraft

# ---- Generation budget ----
# How many plans one signed-in account may generate per rolling 24 hours.
# Default 20 when unset.
#
# Counts ATTEMPTS, not successes. A generation that reached a provider and then
# failed still spent tokens, so it still counts — otherwise failure would be the
# cheap way to use the endpoint. The count is a query over `plans`, which is why
# there is no rate-limit table and no Redis.
#
# Anything that is not a positive integer falls back to the default rather than
# being trusted. Two wrong values used to get through silently: an empty string
# parsed to 0 and answered 429 on the first request of the day, and a word
# parsed to NaN, which made every comparison false and removed the limit
# altogether. A spend control cannot fail open quietly.
#
# A rolling window rather than a calendar day: no timezone to agree on, and no
# midnight cliff where the whole quota returns at once.
DAILY_PLAN_LIMIT=20
